ENVIRONMENT="development"

# SQL Server Configuration (eSSL / Multiple Company DBs)
MSSQL_SERVER="localhost"
MSSQL_PORT=1433
MSSQL_USER="sa"
MSSQL_PASSWORD="your_mssql_password_here"

# Dynamic DB Mapping (Keys to SQL Server Catalog names)
DB_KEY_DB1="etimetracklite1"
DB_KEY_DB2="SCOTO_ACC_ERP"

# Core Scoto ERP (MySQL 8.0 - Master DB)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password_here"
MYSQL_DB_NAME="scoto_erp_db"

