# ==============================================================================
# Scoto Backend - .gitignore
# FastAPI + SQLAlchemy + Alembic + Python 3.x
# ==============================================================================

# 1. Environment & Sensitive Credentials (CRITICAL - Never commit secrets!)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.crt

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode & Optimization Caches
__pycache__/
*.py[cod]
*$py.class
*.pyd

# 4. Packaging, Builds & Egg Info
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 5. IDEs & Code Editors
# JetBrains PyCharm / IntelliJ
.idea/
*.iws
*.iml
*.ipr
out/

# Visual Studio Code
.vscode/
!.vscode/settings.json.example

# General editor temporary files
*.swp
*.swo
*~
.#*

# 6. Database, SQLite & Local Dumps
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.bak

# 7. Logs & Run Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# 8. Testing, Linting & Type Checking Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.pyre/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# 9. Operating System Artifacts
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 10. Temporary & Export Artifacts
tmp/
temp/
export/
*.tmp

